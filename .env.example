# ═══════════════════════════════════════════════════════════════
#  .env.example — oumarousanda.com
#  Copier ce fichier en .env et remplir les vraies valeurs.
#  ⚠️ Ne jamais committer le .env — les vraies clés restent secrètes !
# ═══════════════════════════════════════════════════════════════

# ── Dashboard Admin ──────────────────────────────────────────────
# Mot de passe pour accéder au dashboard /dashboard
VITE_DASHBOARD_PASSWORD=ChangeMeNow2026!

# ── MailZeet — Envoi d'email ─────────────────────────────────────
# Clé API disponible dans le dashboard MailZeet → Settings → Access Keys
# https://app.mailzeet.com/
VITE_MAILZEET_API_KEY=votre_cle_api_mailzeet_ici

# Email expéditeur (doit être autorisé sur ton serveur SMTP Mailzeet)
# Configuré dans : Dashboard MailZeet → Mail Servers
VITE_MAILZEET_SENDER_EMAIL=noreply@oumarousanda.com

# Email de destination (où tu reçois les messages du formulaire de contact)
# Laisser vide pour utiliser contact@oumarousanda.com (valeur par défaut)
VITE_CONTACT_EMAIL=contact@oumarousanda.com
