# ═══════════════════════════════════════════════════════════════
#  .htaccess — oumarousanda.com — Hostinger (Apache/LiteSpeed)
#  SPA routing + Security + Cache aggressif + Brotli/Gzip
# ═══════════════════════════════════════════════════════════════

# ── Activer mod_rewrite ─────────────────────────────────────────
Options -MultiViews
RewriteEngine On

# ── HTTPS force redirect ────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── www → non-www ───────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.oumarousanda\.com$ [NC]
RewriteRule ^ https://oumarousanda.com%{REQUEST_URI} [L,R=301]

# ── Redirections 301 — Anciennes URLs WordPress ─────────────────
RewriteRule ^comment-creer-une-societe-offshore-au-royaume-uni/?$ /blog/societe-offshore-royaume-uni-afrique [R=301,L]
RewriteRule ^fr/comment-creer-une-societe-offshore-au-royaume-uni/?$ /blog/societe-offshore-royaume-uni-afrique [R=301,L]
RewriteRule ^fr/comment-creer-une-societe-offshore-au-royaume-uni-2/?$ /blog/societe-offshore-royaume-uni-afrique [R=301,L]
RewriteRule ^how-to-create-an-offshore-company-in-uk/?$ /blog/societe-offshore-royaume-uni-afrique [R=301,L]
RewriteRule ^comment-acheter-de-la-crypto-monnaie-en-afrique-sur-binance-avec-mobile-money/?$ /blog/mobile-money-business-digital-afrique [R=301,L]
RewriteRule ^fr/comment-gagner-de-largent-sur-internet-en-afrique/?$ /blog/gagner-argent-ia-2026 [R=301,L]
RewriteRule ^fr/comment-gagner-de-largent-avec-les-livres-audio/?$ /blog/gagner-argent-ia-2026 [R=301,L]
RewriteRule ^fr/comment-gagner-100-euros-par-jour/?$ /blog/gagner-argent-ia-2026 [R=301,L]
RewriteRule ^fr/?$ / [R=301,L]
RewriteRule ^fr/blog/?$ /blog [R=301,L]
RewriteRule ^blog/page/[0-9]+/?$ /blog [R=301,L]
RewriteRule ^topics/intelligence-artificielle/?$ /blog [R=301,L]
RewriteRule ^topics/finances/?$ /blog [R=301,L]
RewriteRule ^topics/free-traffic/?$ /blog [R=301,L]
RewriteRule ^online-business-ressources/?$ /ressources [R=301,L]
RewriteRule ^fr/ressources/?$ /ressources [R=301,L]
RewriteRule ^fr/contact/?$ /contact [R=301,L]
RewriteRule ^privacy-policy/?$ / [R=301,L]
RewriteRule ^fr/politique-de-confidentialite/?$ / [R=301,L]
RewriteRule ^terms-and-conditions/?$ / [R=301,L]
RewriteRule ^fr/conditions-generales-dutilisation/?$ / [R=301,L]
RewriteRule ^how-to-make-money-with-nfts-ultimate-guide-for-beginners/?$ /blog [R=301,L]
RewriteRule ^bmo-online-banking-sign-in/?$ /blog [R=301,L]
RewriteRule ^banque-montreal-service-en-ligne/?$ /blog [R=301,L]
RewriteRule ^getresponse-review/?$ /blog [R=301,L]
RewriteRule ^cloudways-review/?$ /blog [R=301,L]
RewriteRule ^best-free-vpn/?$ /blog [R=301,L]
RewriteRule ^poppy-ai-review/?$ /blog [R=301,L]
RewriteRule ^reasons-why-you-need-an-ai-powered-copywriter/?$ /blog [R=301,L]
RewriteRule ^comment-rediger-des-articles-de-blog-avec-lintelligence-artificielle/?$ /blog [R=301,L]
RewriteRule ^comprendre-le-fonds-tiktok-pour-les-createurs/?$ /blog [R=301,L]
RewriteRule ^fr/comprendre-le-fonds-tiktok-pour-les-createurs/?$ /blog [R=301,L]
RewriteRule ^les-etapes-cles-de-la-creation-dune-strategie-de-marketing-en-ligne-coherente-et-performante/?$ /blog [R=301,L]
RewriteRule ^fr/les-etapes-cles-de-la-creation-dune-strategie-de-marketing-en-ligne-coherente-et-performante/?$ /blog [R=301,L]
RewriteRule ^how-to-start-a-blog-that-makes-money/?$ /blog [R=301,L]
RewriteRule ^comment-creer-une-chaine-youtube-monetisable/?$ /blog [R=301,L]
RewriteRule ^fr/comment-creer-une-chaine-youtube-monetisable/?$ /blog [R=301,L]
RewriteRule ^fr/comment-creer-un-blog/?$ /blog [R=301,L]
RewriteRule ^fr/izimentor-avis/?$ /blog/izimentor-avis-2025 [R=301,L]

# ── SPA Single Page Application routing ─────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ── Security Headers ────────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "DENY"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HTTP Strict Transport Security (2 ans)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Content Security Policy (inclut AdSense)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googlesyndication.com https://partner.googleadservices.com https://www.googletagmanager.com https://*.adtrafficquality.google https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https:; media-src 'self' https:; frame-src https://www.youtube.com https://player.vimeo.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://*.adtrafficquality.google; frame-ancestors 'none';"

  # Vary pour les assets compressés (pour les CDNs/proxys)
  <FilesMatch "\.(js|css|html|json)$">
    Header append Vary "Accept-Encoding"
  </FilesMatch>

  # Remove server signature header
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ── Cache agressif ───────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # index.html — jamais caché (toujours frais)
  <FilesMatch "^index\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
  </FilesMatch>

  # Assets Vite (noms hashés → cache 1 an)
  <FilesMatch "\.(js|css|mjs)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|gif|ico)$">
    ExpiresDefault "access plus 6 months"
    Header set Cache-Control "public, max-age=15552000, stale-while-revalidate=86400"
  </FilesMatch>

  # Fonts
  <FilesMatch "\.(woff2|woff|ttf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # SVG
  ExpiresByType image/svg+xml "access plus 1 month"

  # Manifest
  ExpiresByType application/manifest+json "access plus 1 day"

  # Sitemap / robots
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    ExpiresDefault "access plus 1 hour"
  </FilesMatch>
</IfModule>

# ── Brotli (LiteSpeed sur Hostinger — priorité sur Gzip) ─────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/manifest+json image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS font/woff2
</IfModule>

# ── GZIP Compression (fallback si Brotli absent) ─────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ── Preload polices critiques via Early Hints (LiteSpeed) ─────────
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header add Link "</assets/fonts/inter.woff2>; rel=preload; as=font; type=font/woff2; crossorigin"
  </FilesMatch>
</IfModule>

# ── Block access to sensitive files ─────────────────────────────
<FilesMatch "(\.env|\.env\..*|\.git|package\.json|package-lock\.json|compress-images\.mjs)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ── Disable directory listing ───────────────────────────────────
Options -Indexes
